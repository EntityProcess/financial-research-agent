# AgentV target selection
AGENT_TARGET=financial-research-agent
GRADER_TARGET=openai-grader

# Default public-demo target: run a coding/web financial research agent against Dexter's
# public golden answers. This path does not require Dexter's paid Financial
# Datasets API integration.
CODEX_EXECUTABLE=codex-eng
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=low
CODEX_WORKSPACE_DIR=.agentv/codex-workspaces
CODEX_LOG_DIR=.agentv/logs/codex

# Path to a local Dexter checkout pinned to DEXTER_COMMIT.
# Required only for regenerating eval YAML from Dexter CSV or running
# AGENT_TARGET=dexter-agent.
# Example:
#   git clone https://github.com/virattt/dexter.git ../dexter
#   git -C ../dexter checkout 8d9419829f443f84b804d033bb2c3b1fbd788629
DEXTER_REPO_PATH=../dexter
DEXTER_COMMIT=8d9419829f443f84b804d033bb2c3b1fbd788629
DEXTER_MODEL=gpt-5.5
DEXTER_MAX_ITERATIONS=10

# Real Dexter agent prerequisites. Values stay local. Required only when
# AGENT_TARGET=dexter-agent.
OPENAI_API_KEY=
FINANCIAL_DATASETS_API_KEY=
EXASEARCH_API_KEY=
# TAVILY_API_KEY=

# AgentV grader target. Use either OpenAI-compatible or Azure.
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=v1
